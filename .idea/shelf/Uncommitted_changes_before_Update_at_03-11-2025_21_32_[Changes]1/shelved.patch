+package com.example.teachercoursereview
+
+import android.os.Bundle
+import android.widget.Button
+import android.widget.EditText
+import android.widget.RatingBar
+import android.widget.Toast
+import androidx.appcompat.app.AppCompatActivity
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.database.DatabaseReference
+import com.google.firebase.database.FirebaseDatabase
+import org.tensorflow.lite.Interpreter
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+
+class WriteReviewActivity : AppCompatActivity() {
+
+    private lateinit var firebaseDB: DatabaseReference
+    private lateinit var auth: FirebaseAuth
+
+    private lateinit var ratingBar: RatingBar
+    private lateinit var reviewInput: EditText
+    private lateinit var submitButton: Button
+
+    private lateinit var teacherId: String
+    private lateinit var teacherName: String
+
+    private var sentimentInterpreter: Interpreter? = null
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_write_review)
+
+        firebaseDB = FirebaseDatabase.getInstance().reference
+        auth = FirebaseAuth.getInstance()
+
+        teacherId = intent.getStringExtra("teacherId") ?: ""
+        teacherName = intent.getStringExtra("teacherName") ?: ""
+
+        ratingBar = findViewById(R.id.ratingBar)
+        reviewInput = findViewById(R.id.etReview)
+        submitButton = findViewById(R.id.btnSubmit)
+
+        submitButton.setOnClickListener {
+            submitReview()
+        }
+    }
+
+    private fun submitReview() {
+        val reviewText = reviewInput.text.toString().trim()
+        val ratingValue = ratingBar.rating
+
+        if (reviewText.isEmpty() || ratingValue == 0f) {
+            Toast.makeText(this, "Please provide text and rating", Toast.LENGTH_SHORT).show()
+            return
+        }
+
+        val sentiment = predictSentiment(reviewText)
+        val userId = auth.currentUser?.uid ?: "anonymous"
+
+        val review = Review(
+            id = "",
+            teacherId = teacherId,
+            userId = userId,
+            text = reviewText,
+            rating = ratingValue,
+            sentiment = sentiment,
+            timestamp = System.currentTimeMillis()
+        )
+
+        firebaseDB.child("reviews").child(teacherId).push().setValue(review)
+            .addOnSuccessListener {
+                Toast.makeText(this, "Review submitted successfully!", Toast.LENGTH_SHORT).show()
+                finish()
+            }
+            .addOnFailureListener {
+                Toast.makeText(this, "Failed to submit review", Toast.LENGTH_SHORT).show()
+            }
+    }
+
+    private fun predictSentiment(text: String): String {
+        // Placeholder sentiment classification (ML model integration planned)
+        val lower = text.lowercase()
+        return when {
+            listOf("good", "great", "excellent", "nice", "amazing").any { lower.contains(it) } -> "Positive"
+            listOf("bad", "poor", "worst", "terrible", "boring").any { lower.contains(it) } -> "Negative"
+            else -> "Neutral"
+        }
+    }
+
+    override fun onDestroy() {
+        sentimentInterpreter?.close()
+        super.onDestroy()
+    }
+}
