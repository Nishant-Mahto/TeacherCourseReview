+package com.example.teachercoursereview
+
+import android.content.Intent
+import android.os.Bundle
+import android.util.Log
+import android.widget.Button
+import android.widget.TextView
+import android.widget.Toast
+import androidx.appcompat.app.AppCompatActivity
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import com.google.firebase.database.*
+
+class TeacherDetailsActivity : AppCompatActivity() {
+
+    private lateinit var firebaseDB: DatabaseReference
+    private lateinit var reviewsRecyclerView: RecyclerView
+    private lateinit var reviewAdapter: ReviewAdapter
+    private lateinit var reviewsList: MutableList<Review>
+
+    private lateinit var nameText: TextView
+    private lateinit var deptText: TextView
+    private lateinit var ratingText: TextView
+    private lateinit var reviewCountText: TextView
+    private lateinit var emailText: TextView
+    private lateinit var coursesText: TextView
+    private lateinit var noReviewsText: TextView
+
+    private var teacherId: String = ""
+    private var teacherName: String = ""
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_teacher_details)
+
+        teacherId = intent.getStringExtra("teacherId") ?: ""
+        teacherName = intent.getStringExtra("teacherName") ?: ""
+
+        setupViews()
+        setupReviewsList()
+        connectFirebase()
+        loadTeacherData()
+        loadReviewsData()
+
+        findViewById<Button>(R.id.btnBack).setOnClickListener { finish() }
+
+        findViewById<Button>(R.id.btnWriteReview).setOnClickListener {
+            val intent = Intent(this, WriteReviewActivity::class.java)
+            intent.putExtra("teacherId", teacherId)
+            intent.putExtra("teacherName", teacherName)
+            startActivity(intent)
+        }
+
+        findViewById<Button>(R.id.btnViewCourses).setOnClickListener {
+            Toast.makeText(this, "View Courses feature coming soon!", Toast.LENGTH_SHORT).show()
+        }
+    }
+
+    private fun setupViews() {
+        nameText = findViewById(R.id.tvTeacherName)
+        deptText = findViewById(R.id.tvDepartment)
+        ratingText = findViewById(R.id.tvRating)
+        reviewCountText = findViewById(R.id.tvReviewCount)
+        emailText = findViewById(R.id.tvEmail)
+        coursesText = findViewById(R.id.tvCourses)
+        noReviewsText = findViewById(R.id.tvNoReviews)
+        reviewsRecyclerView = findViewById(R.id.recyclerViewReviews)
+        reviewsList = mutableListOf()
+    }
+
+    private fun setupReviewsList() {
+        reviewAdapter = ReviewAdapter(reviewsList)
+        reviewsRecyclerView.layoutManager = LinearLayoutManager(this)
+        reviewsRecyclerView.adapter = reviewAdapter
+        reviewsRecyclerView.isNestedScrollingEnabled = false
+    }
+
+    private fun connectFirebase() {
+        firebaseDB = FirebaseDatabase.getInstance().reference
+    }
+
+    private fun loadTeacherData() {
+        if (teacherId.isEmpty()) return
+
+        firebaseDB.child("teachers").child(teacherId)
+            .addValueEventListener(object : ValueEventListener {
+                override fun onDataChange(snapshot: DataSnapshot) {
+                    val teacherData = snapshot.getValue(Teacher::class.java)
+                    teacherData?.let { displayTeacherInfo(it) }
+                }
+
+                override fun onCancelled(error: DatabaseError) {
+                    Toast.makeText(this@TeacherDetailsActivity, "Error loading teacher details", Toast.LENGTH_SHORT).show()
+                    Log.e("TEACHER_DETAILS", "Error: ${error.message}")
+                }
+            })
+    }
+
+    private fun displayTeacherInfo(teacher: Teacher) {
+        nameText.text = teacher.name
+        deptText.text = teacher.department
+        ratingText.text = String.format("%.1f", teacher.rating)
+        reviewCountText.text = "(${teacher.reviewCount} reviews)"
+        emailText.text = teacher.email
+        coursesText.text = teacher.courses.joinToString(", ")
+    }
+
+    private fun loadReviewsData() {
+        if (teacherId.isEmpty()) return
+
+        firebaseDB.child("reviews").child(teacherId)
+            .addValueEventListener(object : ValueEventListener {
+                override fun onDataChange(snapshot: DataSnapshot) {
+                    reviewsList.clear()
+                    for (reviewSnap in snapshot.children) {
+                        val r = reviewSnap.getValue(Review::class.java)
+                        r?.let { reviewsList.add(it) }
+                    }
+                    if (reviewsList.isEmpty()) {
+                        noReviewsText.visibility = android.view.View.VISIBLE
+                        reviewsRecyclerView.visibility = android.view.View.GONE
+                    } else {
+                        noReviewsText.visibility = android.view.View.GONE
+                        reviewsRecyclerView.visibility = android.view.View.VISIBLE
+                    }
+                    reviewAdapter.notifyDataSetChanged()
+                }
+
+                override fun onCancelled(error: DatabaseError) {
+                    Toast.makeText(this@TeacherDetailsActivity, "Error loading reviews", Toast.LENGTH_SHORT).show()
+                }
+            })
+    }
+
+    override fun onResume() {
+        super.onResume()
+        loadTeacherData()
+        loadReviewsData()
+    }
+}
