@@ -0,0 +1,45 @@
+package com.example.teachercoursereview
+
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.RatingBar
+import android.widget.TextView
+import androidx.recyclerview.widget.RecyclerView
+
+class ReviewAdapter(private val reviewList: List<Review>) :
+    RecyclerView.Adapter<ReviewAdapter.ReviewViewHolder>() {
+
+    inner class ReviewViewHolder(itemView: View) : RecyclerView.ViewHolder(itemView) {
+        val tvReviewer: TextView = itemView.findViewById(R.id.tvReviewer)
+        val tvReviewText: TextView = itemView.findViewById(R.id.tvReviewText)
+        val tvSentiment: TextView = itemView.findViewById(R.id.tvSentiment)
+        val tvTimestamp: TextView = itemView.findViewById(R.id.tvTimestamp)
+        val ratingBar: RatingBar = itemView.findViewById(R.id.ratingBarReview)
+    }
+
+    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): ReviewViewHolder {
+        val view = LayoutInflater.from(parent.context)
+            .inflate(R.layout.item_review, parent, false)
+        return ReviewViewHolder(view)
+    }
+
+    override fun onBindViewHolder(holder: ReviewViewHolder, position: Int) {
+        val review = reviewList[position]
+
+        holder.tvReviewer.text = if (review.userId.isNotEmpty()) "User: ${review.userId}" else "Anonymous"
+        holder.tvReviewText.text = review.text
+        holder.tvSentiment.text = "Sentiment: ${review.sentiment}"
+        holder.ratingBar.rating = review.rating
+        holder.tvTimestamp.text = android.text.format.DateFormat.format("dd MMM yyyy", review.timestamp)
+
+        // Optional color coding for sentiment
+        when (review.sentiment.lowercase()) {
+            "positive" -> holder.tvSentiment.setTextColor(android.graphics.Color.parseColor("#2E7D32")) // green
+            "negative" -> holder.tvSentiment.setTextColor(android.graphics.Color.parseColor("#C62828")) // red
+            else -> holder.tvSentiment.setTextColor(android.graphics.Color.parseColor("#6D6D6D")) // gray
+        }
+    }
+
+    override fun getItemCount(): Int = reviewList.size
+}
