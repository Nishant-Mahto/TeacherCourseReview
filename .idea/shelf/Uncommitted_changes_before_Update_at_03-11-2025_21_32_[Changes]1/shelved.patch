+package com.example.teachercoursereview
+
+import android.content.Intent
+import android.os.Bundle
+import android.util.Log
+import android.widget.Button
+import android.widget.Toast
+import androidx.appcompat.app.AppCompatActivity
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import com.google.android.material.textfield.TextInputEditText
+import com.google.firebase.database.*
+
+class BrowseTeachersActivity : AppCompatActivity() {
+
+    private lateinit var recyclerView: RecyclerView
+    private lateinit var teacherAdapter: TeacherAdapter
+    private lateinit var teachersList: MutableList<Teacher>
+    private lateinit var firebaseDB: DatabaseReference
+    private lateinit var searchBox: TextInputEditText
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_browse_teachers)
+
+        setupViews()
+        setupRecyclerView()
+        setupFirebaseConnection()
+        loadTeachersFromDB()
+
+        findViewById<Button>(R.id.btnBack).setOnClickListener {
+            finish()
+        }
+
+        findViewById<com.google.android.material.floatingactionbutton.FloatingActionButton>(R.id.fabAddTeacher).setOnClickListener {
+            Toast.makeText(this, "Add teacher feature coming soon!", Toast.LENGTH_SHORT).show()
+        }
+    }
+
+    private fun setupViews() {
+        recyclerView = findViewById(R.id.recyclerViewTeachers)
+        searchBox = findViewById(R.id.etSearch)
+        teachersList = mutableListOf()
+    }
+
+    private fun setupRecyclerView() {
+        teacherAdapter = TeacherAdapter(teachersList) { selectedTeacher ->
+            val detailsIntent = Intent(this, TeacherDetailsActivity::class.java)
+            detailsIntent.putExtra("teacherId", selectedTeacher.id)
+            detailsIntent.putExtra("teacherName", selectedTeacher.name)
+            startActivity(detailsIntent)
+        }
+
+        recyclerView.layoutManager = LinearLayoutManager(this)
+        recyclerView.adapter = teacherAdapter
+    }
+
+    private fun setupFirebaseConnection() {
+        firebaseDB = FirebaseDatabase.getInstance().reference.child("teachers")
+    }
+
+    private fun loadTeachersFromDB() {
+        firebaseDB.addValueEventListener(object : ValueEventListener {
+            override fun onDataChange(dataSnapshot: DataSnapshot) {
+                teachersList.clear()
+
+                for (snapshot in dataSnapshot.children) {
+                    val teacherData = snapshot.getValue(Teacher::class.java)
+                    teacherData?.let { teacher ->
+                        teacher.id = snapshot.key ?: ""
+                        teachersList.add(teacher)
+                    }
+                }
+
+                teacherAdapter.notifyDataSetChanged()
+                Log.d("BROWSE_TEACHERS", "Loaded ${teachersList.size} teachers")
+            }
+
+            override fun onCancelled(dbError: DatabaseError) {
+                Toast.makeText(this@BrowseTeachersActivity, "Failed to load teachers", Toast.LENGTH_SHORT).show()
+                Log.e("BROWSE_TEACHERS", "Database error: ${dbError.message}")
+            }
+        })
+    }
+}
